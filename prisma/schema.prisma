generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
  relationMode = "prisma"
}


model User {
  id Int @id @default(autoincrement())
  nome String
  user_type_id Int     
  email String @unique @db.VarChar(100)
  password String @db.VarChar(100)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
//  user_type UserType @relation(fields: [user_type_id], references: [id])

  @@map("user")
}


model UserType {
  id Int @id @default(autoincrement())
  tipo String @db.VarChar(100)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
//  user  User[]

  @@map("user_type")
}


model HabilitacoesLiterarias {
    id Int @id @default(autoincrement())
    nivel_academico String
    instituicao String
    curso String
    @@map("habilitacoes_literarias")
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}


model ExperienciaProfissional {
    id Int @id @default(autoincrement())
    empresa String
    cargo String
    data_inicio DateTime
    data_fim DateTime
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}


model Certificacoes {
    id Int @id @default(autoincrement())
//  photo String? @db.VarChar(255) 
    nome String @unique
//    instituicoes String
//    ano_obtencao DateTime

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}


model Idioma {
    id Int @id @default(autoincrement())
    nome String
    nivel String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}


model RedesSocial {
    id Int @id @default(autoincrement())
    nome String
    link String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

}



model Recrutador {
    id Int @id @default(autoincrement())
    id_user_fk Int

    empresa String
    localizacao String
    cargo String
    setor String
    telefone String
    email String @unique

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}


model TipoContrato {
    id Int @id @default(autoincrement())
    descricao String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}

model ModalidadeTrabalho {
    id Int @id @default(autoincrement())
    descricao String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}

model RequisitosQualificacoes {
    id Int @id @default(autoincrement())
    descricao String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}



model Notificacoes {
    id Int @id @default(autoincrement())
    id_user_fk Int

    tipo_notificacao String
    data_envio DateTime @default(now())
    mensagem String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

}

model Candidato {
    id Int @id @default(autoincrement())

    id_user_fk Int
    id_habilitacoes_literarias_fk Int
    id_experiencia_profissional_fk Int
    id_certificacoes_fk Int
    id_redes_socias_fk Int
    id_idiomas_fk Int

 //   data_nascimento DateTime
    localizacao String
    cargo_recente String
    informacao_adicional String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

}

model Vaga {
    id Int @id @default(autoincrement())

    titulo String
    descricao String
    localizacao String

    id_recrutador_fk Int
    id_tipo_contrato_fk Int
    id_modalidade_trabalho_fk Int
    id_requisitos_qualificacoes_fk Int
    id_tipo_emprego_fk Int
    id_idiomas_fk Int

    data_criacao DateTime
    latitude Float
    longitude Float
    faixa_salariao String
    salario Float

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}

model Candidatura {
    id Int @id @default(autoincrement())
    id_candidato_fk Int
    id_vaga_fk Int

    data_candidatura DateTime
    status String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

}


model HistoricoCandidatura {
    id Int @id @default(autoincrement())
    id_candidatura_fk Int
    status String
    updated_at DateTime @updatedAt
    created_at DateTime @default(now())
}
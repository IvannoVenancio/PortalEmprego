<link rel="stylesheet" href="/CSS/Style.css" />


<body class="Pagina-cadastro">
    <div class="container02-cadastro">
        <h1>Cadastro de Candidato</h1>


        <form class="candidato-form" action="/cadastrocandidato" method="POST" >
            <!-- Nome -->
            <label for="primeiro-nome">Nome Completo</label>
            <input type="text" name="nome_completo" placeholder="Digite seu nome" required>
            <input type="hidden" name="id_user_fk" value="{{user.id}}" >

            <!-- Data de Nascimento -->
            <label for="localização">Data de Nascimento:</label>
            <input type="date" name="data_nascimento" placeholder="Data de Nascimento" required>

            <label for="morada">Certificações Literárias(PDF):</label>
            <input type="file" id="certificacao" name="id_certificacoes_fk" required>

            <label for="Idioma ">Idioma:</label>
            <select id="idioma" name="id_idiomas_fk">
                <option value="">Selecione um idioma</option>
                {{#each idiomas}}
                <option value="{{id}}">{{nome}}</option>
                {{/each}}
            </select>

            {{!-- <label for="Idioma">Idioma:</label>

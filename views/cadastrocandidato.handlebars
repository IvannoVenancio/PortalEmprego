
    <link rel="stylesheet" href="styles.css">

<body>
    <div class="container01">
        <h1>Cadastro de Candidato</h1>

        <form id="candidate-form">
            <!-- Nome -->
            <label for="first-name">Nome:</label>
            <input type="text" id="first-name" name="first-name" placeholder="Digite seu nome" required>
            
            <!-- Sobrenome -->
            <label for="last-name">Sobrenome:</label>
            <input type="text" id="last-name" name="last-name" placeholder="Digite seu sobrenome" required>
            
            <!-- Localidade -->
            <label for="location">Localidade:</label>
            <input type="text" id="location" name="location" placeholder="Cidade/Estado" required>
            
            <!-- Cargo mais recente -->
            <label for="recent-role">Cargo Mais Recente:</label>
            <input type="text" id="recent-role" name="recent-role" placeholder="Ex.: Analista de Marketing" required>
            
            <!-- Informações adicionais -->
            <label for="additional-info">Outras Informações:</label>
            <textarea id="additional-info" name="additional-info" rows="4" placeholder="Adicione informações relevantes..."></textarea>
            
            <!-- Botão caso seja estudante -->
            <div class="student-section">
                <p>É estudante?</p>
                <button type="button" id="student-button" class="btn-student">
                    Clique aqui para cadastro de estudante
                </button>
            </div>

            <!-- Botão de envio -->
            <a href="/Paginainicial" class="btn-submit">Enviar Cadastro</a>
           <!-- <button type="submit" class="btn-submit">Enviar Cadastro</button> -->
        </form>
    </div>
    
</body>
</html>

<link rel="stylesheet" href="/CSS/Style.css" />


<body class="Pagina-cadastro">
    <div class="container02-cadastro">
        <h1>Cadastro de Candidato</h1>

        <form class="candidato-form" action="/cadastrocandidato" method="POST">
                        
            <!-- Nome -->
            <label for="nome_completo">Nome Completo</label>
            <input type="text" name="nome_completo" placeholder="Digite seu nome" required>
            <input type="hidden" name="id_user_fk" value="{{user.id}}" >
            <!-- Data de Nascimento -->
            <label for="data_nascimento">Data de Nascimento:</label>
            <input type="date" name="data_nascimento" placeholder="Data de Nascimento" required>

            <label for="Cargo_recente">Cargo Recente:</label>
            <input type="text" name="Cargo_recente" placeholder="Exemplo: programador frontend..." required>

            {{!-- <label for="id_certificacoes_fk">Certificações Literárias(PDF):</label>
            <input type="file" id="certificacao" name="id_certificacoes_fk" required> --}}
       
            <button type="submit" class="btn-submit">Enviar Cadastro</button>
        </form>
    </div>

</body>

</html>
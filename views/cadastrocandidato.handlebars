
    <link rel="stylesheet" href="styles.css">

<body class="Pagina-cadastro">
    <div class="container02-cadastro">
        <h1>Cadastro de Candidato</h1>

        <form id="candidato-form">
            <!-- Nome -->
            <label for="primeiro-nome">Nome:</label>
            <input type="text" id="first-name" name="first-name" placeholder="Digite seu nome" required>
            
            <!-- Sobrenome -->
            <label for="sobre-nome">Sobrenome:</label>
            <input type="text" id="last-name" name="last-name" placeholder="Digite seu sobrenome" required>
            
            <!-- Localidade -->
            <label for="localização">Localidade:</label>
            <input type="text" id="localização" name="localização" placeholder="Cidade/Estado" required>
            
            <!-- Cargo mais recente -->
            <label for="recente-emprego">Cargo Mais Recente:</label>
            <input type="text" id="recente-emprego" name="recente-emprego" placeholder="Ex.: Analista de Marketing" required>
            
    
            <!-- Botão caso seja estudante -->
            <div class="Secção-Estudante">
                <p>É estudante?</p>
                <button type="button" id="botão-estudante" class="btn-estudante">
                    Clique aqui para cadastro de estudante
                </button>
            </div>

            <!-- Botão de envio -->
            <a href="/Paginainicial" class="btn-enviocadastro">Enviar Cadastro</a>
           <!-- <button type="submit" class="btn-submit">Enviar Cadastro</button> -->
        </form>
    </div>
    
</body>
</html>

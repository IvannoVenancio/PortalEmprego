<body>
<h1>Pagina default pra candidatos</h1>
    {{#each users  }}

        <td>Id: {{id}}</td><br>
        <td>Cargo recente: {{cargo_recente}}</td><br>
        <td>Id de certificado: {{id_certificacoes_fk}}</td><br>
        <tr>
        {{#each certificacoes  }}
            {{#if users.id = certificacoes.id}}
                <tr>
                    <td>Id: {{id}}</td><br>
                    <td>Nome: {{nome}}</td><br>
                </tr>
            {{/if}}
        {{/each}}


        <td>Informação adicional: {{informacao_adicional}}</td><br><br>
        </tr>
    {{/each}}
</table>
</body>
<link rel="stylesheet" href="Style.css">
 
    
 <body class="Paginainicial">
   

    <!-- Seção principal -->
    <main class="container-paginaprincipal">
        <!-- Coluna da esquerda -->
        <aside class="Barralateral-esquerda">
            <div class="perfil-usuario">
                
                <h4>{{user.email}}</h4>
            </div>
            <ul>
                <li><a href="/Perfil"><i class="fas fa-user"></i> Meu Perfil</a></li>
                <li><a href="/Vaga"><i class="fas fa-briefcase"></i> Vagas</a></li>
                <li><a href="#messages"><i class="fas fa-envelope"></i> Mensagens</a></li>
                <li><a href="#notifications"><i class="fas fa-bell"></i> Notificações</a></li>
                <li><a href="/logout"><i class="fas fa-bell"></i> Sair</a></li>
                
            </ul>
        </aside>

        <!-- Feed principal -->
        <section class="feedpag-candidato">
            <div class="caixapost-candidato">
                <textarea placeholder="O que você está pensando?"></textarea>
                <div class="Opçõespost-candidato">
                    <button><i class="fas fa-image"></i> Foto</button>
                    <button><i class="fas fa-video"></i> Vídeo</button>
                    <button class="btn-publicarcand">Publicar</button>
                </div>
            </div>
            <div class="postagens-candidato">
                <div class="postagenscand-header">
                    <img src="https://via.placeholder.com/50" alt="User">
                    <div>
                        <h4>João Silva</h4>
                        <p>2 horas atrás</p>
                    </div>
                </div>
                <div class="conteinerpost-candidato">
                    <p>Consegui um novo emprego graças ao DigmaWorks! Recomendo a todos!</p>
                </div>
                <div class="postreações-candidato">
                    <button><i class="fas fa-thumbs-up"></i> Curtir</button>
                    <button><i class="fas fa-comment"></i> Comentar</button>
                </div>
            </div>
        </section>

        <!-- Coluna da direita -->
        <aside class="barralateral-dircand">
            <h3>Sugestões de Conexão</h3>
            <div class="sugestões-candidato">
                <img src="https://via.placeholder.com/40" alt="User">
                <div>
                    <h4>Maria Oliveira</h4>
                    <button class="btn-primary">Conectar</button>
                </div>
            </div>
            <div class="sugestões-candidato">
                <img src="https://via.placeholder.com/40" alt="User">
                <div>
                    <h4>Carlos Mendes</h4>
                    <button class="btn-primary">Conectar</button>
                </div>
            </div>
        </aside>
    </main>

        
</body>
</html>

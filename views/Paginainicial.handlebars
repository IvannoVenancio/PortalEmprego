<link rel="stylesheet" href="Style.css">
 
    
<body>
    <header class="main-header">
        <nav class="navbar">
            <div class="logo">Digma <span>Works</span></div>
            <ul class="nav-links">
                <li><a href="/Vaga">Vagas</a></li>
                <li><a href="#candidates">Candidatos</a></li>
                <li><a href="#recruiters">Recrutadores</a></li>
                <li><a href="#about">Sobre</a></li>
                <li><a href="#contact" class="btn-nav">Contato</a></li>
            </ul>
        </nav>
    </header>

    <!-- Seção de Banner Interativo -->
    <section class="hero-section">
        <div class="hero-content">
            <h1>Encontre o Trabalho dos Seus Sonhos</h1>
            <p>Conectando talentos às melhores oportunidades do mercado.</p>
            <form class="search-jobs">
                <input type="text" placeholder="Pesquise por cargo ou empresa" />
                <select>
                    <option value="" disabled selected>Selecione uma área</option>
                    <option value="tecnologia">Tecnologia</option>
                    <option value="saude">Saúde</option>
                    <option value="educacao">Educação</option>
                    <option value="administracao">Administração</option>
                </select>
                <button type="submit">Buscar Vagas</button>
            </form>
        </div>
    </section>

    <!-- Seção para Candidatos e Recrutadores -->
    <section id="candidates" class="section">
        <h2>Para Candidatos</h2>
        <div class="cards">
            <div class="card">
                <i class="fas fa-user-tie"></i>
                <h3>Crie Seu Currículo</h3>
                <p>Construa um perfil profissional que chame a atenção dos recrutadores.</p>
                <a href="/candidate-registration" class="btn-card">Começar Agora</a>
            </div>
            <div class="card">
                <i class="fas fa-search"></i>
                <h3>Encontre Vagas</h3>
                <p>Explore milhares de oportunidades que combinam com o seu perfil.</p>
                <a href="/jobs" class="btn-card">Ver Vagas</a>
            </div>
        </div>
    </section>

    <section id="recruiters" class="section">
        <h2>Para Recrutadores</h2>
        <div class="cards">
            <div class="card">
                <i class="fas fa-briefcase"></i>
                <h3>Publique Vagas</h3>
                <p>Divulgue oportunidades e encontre os melhores talentos.</p>
                <a href="/recruiter-registration" class="btn-card">Cadastrar Empresa</a>
            </div>
            <div class="card">
                <i class="fas fa-chart-line"></i>
                <h3>Gestão de Talentos</h3>
                <p>Acompanhe o progresso dos candidatos com ferramentas avançadas.</p>
                <a href="/recruiter-dashboard" class="btn-card">Acessar Dashboard</a>
            </div>
        </div>
    </section>

    
    
</body>
</html>



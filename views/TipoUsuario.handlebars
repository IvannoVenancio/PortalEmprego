<h1>Tipo de Utilizador</h1>

<form action="/tipo_usuario" method="post">
    <input type="text" name="tipo" placeholder="Tipo" ><br>
    
    <input type="submit" value="Cadastrar">
</form>

<table>
    <tr>
        <td>#</td>
        <td>Tipo de Usuario</td>
    </tr>
    {{#each TipoUsuario}}
    <tr>
        <td>{{id}}</td>
        <td>{{tipo}}</td>
    </tr>
    {{/each}}
</table>
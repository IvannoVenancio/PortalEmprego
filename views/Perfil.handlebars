            <!-- Resumo Pessoal -->
            <div class="perfil-section">
                <h3>Resumo Pessoal</h3>
                <textarea class="input-field" id="formacao" placeholder="Descreva os seu resumo pessoal..."></textarea>
                <button class="btn" onclick="saveEducation()">Salvar</button>
            </div>

            <!-- Experiência Profissional -->


             <!-- Formulário para adicionar ou editar experiência -->
            <div class="perfil-section">
                <h3>Experiência Profissional</h3>
                <textarea class="input-field" id="experiencia" placeholder="Descreva sua experiência profissional..."></textarea>
                <button class="btn" onclick="saveExperience()">Salvar</button>
            </div>


            <!-- Formação Acadêmica -->
            <div class="perfil-section">

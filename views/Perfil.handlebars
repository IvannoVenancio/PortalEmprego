  <title>Perfil - Digma Work</title>
    <!-- Vincula o arquivo CSS -->
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <!-- Header da Página -->
    <div class="profile-header">
        <h1>Digma Work</h1>
        <p>Conectando Profissionais e Oportunidades</p>
    </div>

    <!-- Perfil do Usuário -->
    <div class="container">
        <div class="profile-info text-center">
            <img src="https://via.placeholder.com/150" alt="Foto de Perfil" class="profile-img">
            <h2>Nome do Usuário</h2>
            <p>Cargo Atual • Localidade</p>
            <button class="btn btn-primary">Editar Perfil</button>
        </div>

        <!-- Navegação do Perfil -->
        <div class="profile-nav">
            <nav>
                <a href="#" class="active">Timeline</a>
                <a href="#">Sobre</a>
                <a href="#">Amigos</a>
                <a href="#">Fotos</a>
            </nav>
        </div>

        <!-- Caixa de Postagem -->
        <div class="post-box">
            <textarea class="post-input" placeholder="No que você está pensando?"></textarea>
            <div class="actions">
                <button class="btn">Foto</button>
                <button class="btn">Publicar</button>
            </div>
        </div>

        <!-- Posts -->
        <div class="post">
            <div class="post-header">
                <strong>Nome do Usuário</strong>
                <small>2 horas atrás</small>
            </div>
            <p>Este é um exemplo de um post no portal Digma Work!</p>
        </div>

        <div class="post">
            <div class="post-header">
                <strong>Outro Usuário</strong>
                <small>1 dia atrás</small>
            </div>
            <p>Gostei muito desta plataforma!</p>
        </div>
    </div> 
                <button class="btn" onclick="saveEducation()">Salvar</button>
            </div>

            <!-- Habilidades -->
            <div class="perfil-section">
                <h3>Habilidades</h3>
                <textarea class="input-field" id="habilidades" placeholder="Liste suas habilidades..."></textarea>
                <button class="btn" onclick="saveSkills()">Salvar</button>

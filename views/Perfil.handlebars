  <title>Perfil - Digma Work</title>
    <!-- Vincula o arquivo CSS -->
    <link rel="stylesheet" href="styles.css">
</head>
<body class="PerfilRecrutador">
    <div class="container-perfil">
        
    <!-- Perfil do Usuário -->
    <div class="containerperfil">
        <div class="perfil-info">
            <img src="https://via.placeholder.com/150" alt="Foto de Perfil" class="perfil-img">
            <h2>Nome do Usuário</h2>
            <p>Cargo Atual • Localidade</p>
            <button class="btn btn-primary-perfil">Editar Perfil</button>
        </div>



        <!-- Navegação do Perfil -->
        <div class="perfil-nav">
            <nav>
                <a href="#" class="active">Timeline</a>
                <a href="#">Sobre</a>
                <a href="#">Amigos</a>
                <a href="#">Fotos</a>
            </nav>
        </div>

        <!-- Caixa de Postagem -->
        <div class="post-box-perfil">
            <textarea class="post-input-perfil" placeholder="No que você está pensando?"></textarea>
            <div class="acção-perfil">
                <button class="btn">Foto</button>
                <button class="btn">Publicar</button>
            </div>
        </div>


             <!-- Resumo Pessoal -->
            <div class="perfil-section">
                <h3>Resumo Pessoal</h3>
                <p>Profissional com experiência em desenvolvimento de software, focado em tecnologias modernas e práticas ágeis.</p>
            </div> 

            <!-- Experiência Profissional -->
            <div class="perfil-section">
                <h3>Experiência Profissional</h3>
                <ul>
                    <li>
                        <strong>Desenvolvedor Full Stack</strong> - Empresa X (Jan 2020 - Atual)
                        <p>Desenvolvimento de aplicações web utilizando React e Node.js.</p>
                    </li>
                </ul>
            </div>
        </div>

           <!-- Formação Acadêmica -->
        <div class="perfil-section">
            <h3>Formação Acadêmica</h3>
            <ul>
                <li>
                    <strong>Bacharelado em Ciência da Computação</strong> - Universidade Z (2014 - 2018)
                </li>
                <li>
                    <strong>Técnico em Informática</strong> - Escola Técnica W (2012 - 2014)
                </li>
            </ul>
        </div>

        <!-- Habilidades -->
        <div class="perfil-section">
            <h3>Habilidades</h3>
            <ul class="Habilidades-list">
                <li>Programação em JavaScript, Python</li>
                <li>Desenvolvimento Front-End (HTML, CSS, React)</li>
                <li>Desenvolvimento Back-End (Node.js, SQL, MongoDB)</li>
                <li>Metodologias Ágeis (Scrum, Kanban)</li>
            </ul>
        </div>
        <!-- Barra Lateral Esquerda -->
        <aside class="sidebar-leftperfil">
            <h3>Atalhos</h3>
            <ul>
                <li><a href="#">Pagina Principal</a></li>
                <li><a href="#">Mensagens</a></li>
                <li><a href="#">Notificações</a></li>
                <li><a href="#">Configurações</a></li>
            </ul>
        </aside>

        <!-- Barra Lateral Direita -->
        <aside class="sidebar-direitaperfil">
            <h3>Recomendações</h3>
            <div class="recommendaçãoperfil">
                <p><strong>Joana Oliveira</strong>: "Profissional exemplar!"</p>
            </div>
            <div class="recommendaçãoperfil">
                <p><strong>Carlos Silva</strong>: "Recomendo para projetos complexos!"</p>
            </div>
        </aside>
    </div>

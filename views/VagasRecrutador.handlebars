<link rel="stylesheet" href="/CSS/Style.css" />

<body class="VagasRecrutador">
  <!-- Barra de Navegação -->
  <nav class="navbar-VagasRecrutador">
    <div class="nav-linksVagasRecrutador">
      <a href="/PaginaRecrutadores">Pagina Inicial</a>
      <a href="/jobs" class="active">Minhas Vagas</a>
      <a href="/PerfilRecrutador">Perfil</a>
      <a href="/logout">Sair</a>
    </div>
  </nav>

  <!-- Conteúdo Principal -->
  <div class="container-VagasRecrutador">
    <header class="header-VagasRecrutador">
      <h1>Minhas Vagas</h1>
      <a href="/CadastroVagas" class="btn-createVagRe">Criar Nova Vaga</a>
    </header>

    <!-- Lista de Vagas -->



    <section class="lista-vagasrecrutador">
      {{#each Vaga}}
      <div class="vagasrecrutador-card">
          <h3>{{titulo}}</h3>
          <p><strong>Descrição:</strong> {{descricao}}</p>
          <p><strong>Localização:</strong> {{localizacao}}</p>
          <p><strong>Salário:</strong> KZ {{salario}}</p>
          <p><strong>Tipo de contrato:</strong> {{tipoContrato}}</p>
          <hr>
        </div>
        <p><strong>Status:</strong> Aberta</p>
        <div class="ação-vagasrecrutador">
          <button class="btn-editar-VagRe">Editar</button>
          <button class="btn-delete-VagRe">Excluir</button>
        </div>
      </div>
      {{/each}}

</body>

</html>
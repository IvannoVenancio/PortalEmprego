
    <link rel="stylesheet" href="styles.css">

<body>
    <div class="container02">
        <h1>Cadastro de Recrutador</h1>
        <form id="recruiter-form">
            <!-- Nome -->
            <label for="first-name">Nome:</label>
            <input type="text" id="first-name" name="first-name" placeholder="Digite seu nome" required>
            
            <!-- Sobrenome -->
            <label for="last-name">Sobrenome:</label>
            <input type="text" id="last-name" name="last-name" placeholder="Digite seu sobrenome" required>
            
            <!-- Localidade -->
            <label for="location">Localidade:</label>
            <input type="text" id="location" name="location" placeholder="Cidade/Estado" required>
            
            <!-- Empresa -->
            <label for="company">Empresa:</label>
            <input type="text" id="company" name="company" placeholder="Nome da empresa" required>
            
            <!-- Cargo -->
            <label for="role">Cargo:</label>
            <input type="text" id="role" name="role" placeholder="Ex.: Gerente de Recursos Humanos" required>

            <!-- Campo para setor da empresa -->
            <label for="industry">Setor da Empresa:</label>
            <input type="text" id="industry" name="industry" placeholder="Ex.: Tecnologia, Saúde, Educação" required>

            <!-- Telefone -->
            <label for="phone">Telefone:</label>
            <input type="tel" id="phone" name="phone" placeholder="Ex.: (11) 98765-4321" pattern="\(\d{2}\) \d{5}-\d{4}" required>

            <!-- E-mail -->
            <label for="email">E-mail:</label>
            <input type="email" id="email" name="email" placeholder="Ex.: exemplo@empresa.com" required>
            
            <!-- Informações adicionais -->
            <label for="additional-info">Descrição da Empresa:</label>
            <textarea id="additional-info" name="additional-info" rows="4" placeholder="Adicione uma breve descrição da sua empresa..."></textarea>
            
            <!-- Botão de envio -->
             <a href="/PaginaRecrutadores" class="btn-submit">Cadastrar</a>
        </form>
    </div>
    
</body>
</html>

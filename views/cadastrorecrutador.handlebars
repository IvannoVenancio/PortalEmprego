<body>
<h1>Cadastro de Recrutador</h1>
<form action="/cadastrorecrutador" method="POST">
    <!-- Nome -->
    <label for="name">Nome:</label>
    <input type="text" id="name" name="form_name" placeholder="Digite seu nome" required>

    <!-- Localidade -->
    <label for="location">Localidade:</label>
    <input type="text" id="location" name="form_location" placeholder="Cidade/Estado" required>

    <!-- Empresa -->
    <label for="company">Empresa:</label>
    <input type="text" id="company" name="form_company" placeholder="Nome da empresa" required>

    <!-- Cargo -->
    <label for="role">Cargo:</label>
    <input type="text" id="role" name="form_role" placeholder="Ex.: Gerente de Recursos Humanos" required>

    <!-- Campo para setor da empresa -->
    <label for="industry">Setor da Empresa:</label>
    <input type="text" id="industry" name="form_industry" placeholder="Ex.: Tecnologia, Saúde, Educação" required>

    <!-- Telefone -->
    <label for="phone">Telefone:</label>
    <input type="tel" id="phone" name="form_phone" placeholder="Ex.: (11) 912-345-678" required>

    <!-- E-mail -->
    <label for="email">E-mail:</label>
    <input type="email" id="email" name="form_email" placeholder="Ex.: exemplo@empresa.com" required>

    <!-- Informações adicionais -->
    <label for="additional-info">Descrição da Empresa:</label>
    <textarea id="additional-info" name="form_additional_info" rows="4" placeholder="Adicione uma breve descrição da sua empresa..."></textarea>

    <!-- Botão de envio -->
    <button type="submit">Cadastrar como recrutador</button>
</form>
</body>
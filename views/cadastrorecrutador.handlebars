
    <link rel="stylesheet" href="styles.css">

<body class="pagina-recrutador">
    <div class="container1-recrutador">
        <h1>Cadastro de Recrutador</h1>
        <form id="form-recrutador">
            <!-- Nome -->
            <label for="primeiro-nome">Nome:</label>
            <input type="text" id="primeiro-nome" name="primeiro-nome" placeholder="Digite seu nome" required>
            
            <!-- Sobrenome -->
            <label for="sobrenome">Sobrenome:</label>
            <input type="text" id="sobrenome" name="sobrenome" placeholder="Digite seu sobrenome" required>
            
            <!-- Localidade -->
            <label for="localização">Localidade:</label>
            <input type="text" id="localização" name="localização" placeholder="Cidade/Estado" required>
            
            <!-- Empresa -->
            <label for="compania">Empresa:</label>
            <input type="text" id="compania" name="compania" placeholder="Nome da empresa" required>
            
            <!-- Cargo -->
            <label for="cargo">Cargo:</label>
            <input type="text" id="cargo" name="cargo" placeholder="Ex.: Gerente de Recursos Humanos" required>

            <!-- Campo para setor da empresa -->
            <label for="industria">Setor da Empresa:</label>
            <input type="text" id="industria" name="industria" placeholder="Ex.: Tecnologia, Saúde, Educação" required>

            <!-- Telefone -->
            <label for="Telefone">Telefone:</label>
            <input type="tel" id="Telefone" name="Telefone" placeholder="Ex.: (+244) 923-234-256" pattern="\(\d{2}\) \d{5}-\d{4}" required>

            <!-- E-mail -->
            <label for="email">E-mail:</label>
            <input type="email" id="email" name="email" placeholder="Ex.: exemplo@empresa.com" required>
            
            <!-- Informações adicionais -->
            <label for="info-adicional">Descrição da Empresa:</label>
            <textarea id="info-adicional" name="info-adicional" rows="4" placeholder="Adicione uma breve descrição da sua empresa..."></textarea>
            
            <!-- Botão de envio -->
             <a href="/PaginaRecrutadores" class="btn-enviorecrutador">Cadastrar</a>
        </form>
    </div>
    
</body>
</html>

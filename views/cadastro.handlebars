<link rel="stylesheet" href="/CSS/Style.css" />
<h2 class="titulo-cadastro" style="margin-top: 80px; font-size: 28px; text-align: center; color: #2c3e50;">CRIE SUA
  CONTA AGORA!<br>OPORTUNIDADES ESPERAM POR VOCÊ!</h2>

<body class="container-cadastro">
  <div class="container-registro">
    <h2>Cadastrar-se</h2>

    <form class="cadastro-form" action="/cadastro" method="post">

      <label for="email">Email:</label>
      <input type="email" id="email" name="email" required /><br>
      <label for="password">Senha:</label>
      <input type="password" id="password" name="password" required /><br>

      <select name="user_type" id="">
        <option value="">Tipo de Usuario</option>
        {{#each tipoUsuario}}
        <option value="{{id}}">{{tipo}}</option>
        {{/each}}
      </select> <br>
      <button type="submit">Cadastrar</button>
    </form>

    <p>Já tem uma conta? <a href="/login">Entrar</a></p>
  </div>








  <div class="buttons">
    <a href="/tipo_usuario">User Type</a>
  </div>

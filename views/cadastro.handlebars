<body>
  <form action="/cadastro" method="POST">
    <label for="name">Nome:</label>
    <input type="text" id="name" name="form_name" required />

    <label for="email">Email:</label>
    <input type="email" id="email" name="form_email" required />

    <label for="password">Senha:</label>
    <input type="password" id="password" name="form_password" required />
    <br>
    <br>
  
    <input type="radio" id="candidato" name="form_type_of_account" value="candidato">
    <label for="candidato">Candidato</label><br>
    <input type="radio" id="recrutador" name="form_type_of_account" value="recrutador">
    <label for="recrutador">Recrutador</label><br>

    <button type="submit">Cadastrar</button>
  </form>

    <p>Já tem uma conta? <a href="/login">Entrar</a></p>
</body>


    <link rel="stylesheet" href="/CSS/Style.css"/>
<body>
    <!-- Cabeçalho com barra de navegação -->
    <header class="navbar">
        <div class="logo">Digma<span>Works</span></div>
        <div class="search-bar">
            <input type="text" placeholder="Pesquisar no portal...">
            <button><i class="fas fa-search"></i></button>
        </div>
        
    </header>

    <!-- Seção principal -->
    <main class="main-container">
        <!-- Coluna da esquerda -->
        <aside class="left-sidebar">
            <ul>
                <li><a href="/Perfil"><i class="fas fa-user"></i> Meu Perfil</a></li>
                <li><a href="#jobs"><i class="fas fa-briefcase"></i> Vagas</a></li>
                <li><a href="#messages"><i class="fas fa-envelope"></i> Mensagens</a></li>
                <li><a href="#notifications"><i class="fas fa-bell"></i> Notificações</a></li>
            </ul>
        </aside>

        <!-- Feed principal -->
        <section class="feed">
            <div class="post-box">
                <textarea placeholder="O que você está pensando?"></textarea>
                <div class="post-options">
                    <button><i class="fas fa-image"></i> Foto</button>
                    <button><i class="fas fa-video"></i> Vídeo</button>
                    <button class="btn-primary">Publicar</button>
                </div>
            </div>
            <div class="post">
                <div class="post-header">
                    <img src="https://via.placeholder.com/50" alt="User">
                    <div>
                        <h4>João Silva</h4>
                        <p>2 horas atrás</p>
                    </div>
                </div>
                <div class="post-content">
                    <p>Consegui um novo emprego graças ao DigmaWorks! Recomendo a todos!</p>
                </div>
                <div class="post-actions">
                    <button><i class="fas fa-thumbs-up"></i> Curtir</button>
                    <button><i class="fas fa-comment"></i> Comentar</button>
                </div>
            </div>
        </section>

        <!-- Coluna da direita -->
        <aside class="right-sidebar">
            <h3>Sugestões de Conexão</h3>
            <div class="suggestion">
                <img src="https://via.placeholder.com/40" alt="User">
                <div>
                    <h4>Maria Oliveira</h4>
                    <button class="btn-primary">Conectar</button>
                </div>
            </div>
            <div class="suggestion">
                <img src="https://via.placeholder.com/40" alt="User">
                <div>
                    <h4>Carlos Mendes</h4>
                    <button class="btn-primary">Conectar</button>
                </div>
            </div>
        </aside>
    </main>
</body>
</html>

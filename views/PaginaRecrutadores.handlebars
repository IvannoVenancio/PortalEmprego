
    <link rel="stylesheet" href="/CSS/Style.css"/>
<body class="PaginaRecrutador">


    <!-- Seção principal -->
    <main class="main-containerPagRecrutador">
        <!-- Coluna da esquerda -->
        <aside class="left-sidebarPagRecrutador">
            <ul>
                <li><a href="/Perfil"><i class="fas fa-user"></i> Meu Perfil</a></li>
                <li><a href="/VagasRecrutador"><i class="fas fa-briefcase"></i> Vagas</a></li>
                <li><a href="#messages"><i class="fas fa-envelope"></i> Mensagens</a></li>
                <li><a href="#notifications"><i class="fas fa-bell"></i> Notificações</a></li>
            </ul>
        </aside>

       
    

        <!-- Feed principal -->
        <section class="feed-PagRecrutador">
            <div class="post-boxPagRecrutador">
                <textarea placeholder="O que você está pensando?"></textarea>
                <div class="post-opçõesPagRecrutador">
                    <button><i class="fas fa-image"></i> Foto</button>
                    <button><i class="fas fa-video"></i> Vídeo</button>
                    <button class="btn-primary">Publicar</button>
                </div>
            </div> 
             <div class="postes-PagRecrutador">
                <div class="postes-headerPagRecrutador">
                    <img src="https://via.placeholder.com/50" alt="User">
                    <div class="postenome">
                        <h4>João Silva</h4>
                        <p>2 horas atrás</p>
                    </div>
                </div> 
                 <div class="postes2-PagRecrutador">
                    <p>Consegui um novo emprego graças ao DigmaWorks! Recomendo a todos!</p>
                </div>
                <div class="postação-PagRecrutador">
                    <button><i class="fas fa-thumbs-up"></i> Curtir</button>
                    <button><i class="fas fa-comment"></i> Comentar</button>
                </div>
            </div>
        </section> 

        <!-- Coluna da direita -->
        <aside class="right-sidebarPagRecrutador">
            <h3 style=" color: #dde4eb;" >Sugestões de Conexão</h3>
            <div class="sugestõesPagRecrutador">
                <img src="https://via.placeholder.com/40" alt="User">
                <div>
                    <h4 style=" color: #dde4eb;">Maria Oliveira</h4>
                    <button class="btn-primary">Conectar</button>
                </div>
            </div>
            <div class="sugestõesPagRecrutador">
                <img src="https://via.placeholder.com/40" alt="User">
                <div>
                    <h4 style=" color: #dde4eb;">Carlos Mendes</h4>
                    <button class="btn-primary">Conectar</button>
                </div>
            </div>
        </aside>
    </main>
</body>
</html>
